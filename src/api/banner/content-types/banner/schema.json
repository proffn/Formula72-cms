{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "text"
    },
    "subtitle": {
      "type": "text"
    },
    "textPosition": {
      "type": "enumeration",
      "enum": ["left-top", "right-center"],
      "default": "left-top"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
